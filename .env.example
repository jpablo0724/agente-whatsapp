# Puerto donde corre el servidor
PORT=3000

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI (solo se usa para transcribir audios con Whisper) ---
OPENAI_API_KEY=

# --- Clientify CRM ---
# El WhatsApp ya está conectado como canal dentro del Team Inbox de
# Clientify — el agente no habla directo con Meta, habla con Clientify
# (API V2, plan Avanzada) y Clientify reenvía hacia/desde WhatsApp.
CLIENTIFY_API_KEY=
CLIENTIFY_API_BASE_URL=https://api-plus.clientify.com

# Secreto propio para proteger nuestro endpoint /webhook/clientify.
# Clientify reenvía los mensajes "best-effort" y SIN firma HMAC, así que
# este secreto (que vos inventás) se agrega como query string al configurar
# el webhook en Clientify, y acá se valida que coincida.
CLIENTIFY_WEBHOOK_SECRET=

# Conversación de Clientify con el dueño del negocio (opcional). El
# agente la usa para avisar por WhatsApp cuando aprende algo importante
# y esperar tu sí/no. Para conseguir el id: escribile una vez al número
# de WhatsApp del negocio desde tu propio celular, y buscá esa
# conversación con GET /v2/conversations/?fields=id,contact_id,...
OWNER_CONVERSATION_ID=

# Base de datos SQLite local (conversaciones, mensajes, cola de revisión)
DATABASE_PATH=./data.sqlite
