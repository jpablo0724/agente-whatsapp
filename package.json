{
	"name": "agente-whatsapp",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"start": "node dist/server.js",
		"build": "tsc -b && node -e \"require('fs').cpSync('src/knowledge/documents','dist/knowledge/documents',{recursive:true})\"",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.68.0",
		"better-sqlite3": "^12.4.1",
		"dotenv": "^17.2.3",
		"express": "^5.1.0",
		"multer": "^2.0.1",
		"openai": "^6.9.1",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/express": "^5.0.5",
		"@types/multer": "^1.4.12",
		"@types/node": "^24.13.3",
		"tsx": "^4.20.6",
		"typescript": "~6.0.2"
	},
	"allowScripts": {
		"better-sqlite3@12.11.1": true,
		"esbuild@0.28.2": true
	}
}
